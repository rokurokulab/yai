# Editors / IDEs
.vscode/
.cursor/
.idea/
*.swp
*~

# OS
**/.DS_Store

# Local test/debug artifacts (NEVER commit; safety net for the
# "smoke-test then cleanup" rule)
tmp/
/tmp/yai-test-*

# Env
.env
.env.*
!.env.example

# Logs
logs/
*.log

# yai runtime state — vendored code under .yai/bin/ and .yai/prompts/
# is tracked, along with the PRD files. Everything else is local state.
.yai/runs/
.yai/archive/
.yai/active-story.json
.yai/.last-branch
.yai/.last-run
.yai/.last-archive-key
.yai/progress.txt
.yai/completed-stories.json
